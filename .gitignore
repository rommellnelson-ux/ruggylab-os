.env
.codex-ui-server.pid
.claude/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.db
*.db-shm
*.db-wal
backups/
# ML model weights stored at repo root — never commit large binary model files
/models/
logs/
bandit_report.txt
pip_audit_report.txt
*.egg-info/
dist/
build/
.coverage
coverage.xml
htmlcov/
artifacts/*
# Les artefacts G0 font exception : ils sont VERSIONNÉS, et c'est le point.
# `--check` compare le code au fichier versionné ; sans ce fichier, il n'y
# aurait rien à comparer et la baseline dériverait sans que rien ne le dise.
#
# `artifacts/*` et non `artifacts/` : git n'applique pas une négation si le
# RÉPERTOIRE parent est exclu — il ne descend même pas dedans.
!artifacts/g0/
